#!/data/data/com.termux/files/usr/bin/bash
set -u

YGG_BIN="${YGG_BIN:-$HOME/.local/bin/yggsync}"
CONFIG="${YGG_SYNC_CONFIG:-$HOME/.config/ygg_sync.toml}"
RUNTIME="${YGG_SYNC_RUNTIME:-$HOME/.config/yggsync.runtime.toml}"
PROFILE="${PROFILE:-obsidian}"
JOBS="${JOBS:-obsidian}"
WORKTREE_OP="${WORKTREE_OP:-sync}"
LOG_DIR="$HOME/.local/state/yggsync"
LOG_FILE="$LOG_DIR/manual-obsidian.log"

mkdir -p "$LOG_DIR"

termux-toast "yggsync obsidian: starting"
"$YGG_BIN" obsidian -config "$CONFIG" -runtime "$RUNTIME" -reason manual -worktree-op "$WORKTREE_OP" >>"$LOG_FILE" 2>&1
status=$?
if [ $status -eq 0 ]; then
  termux-toast "yggsync obsidian done"
else
  termux-toast -b red -c white "yggsync obsidian failed ($status)"
fi
