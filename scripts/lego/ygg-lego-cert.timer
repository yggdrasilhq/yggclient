[Unit]
Description=Run ygg-lego-cert.service every three days to manage certificates
Requires=ygg-lego-cert.service

[Timer]
# Run every 3 days
OnUnitActiveSec=3d
RandomizedDelaySec=12h  # Spread load on ACME servers (up to 12 hour delay)
Persistent=true         # Run on next boot if a scheduled run was missed
Unit=ygg-lego-cert.service # Ensure this matches the .service file name

[Install]
WantedBy=timers.target
