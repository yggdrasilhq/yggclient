#!/bin/bash

# Private values should come from config/profiles.local.env (gitignored),
# or be pre-exported in the shell environment.

# Shipped placeholder values (see config/profiles.example.env) count as
# UNCONFIGURED: normalize them to unset so the emptiness guard below skips
# silently instead of firing the loader at the example endpoint. Measured
# 2026-09-11 on jojo: an emptiness-only guard let the placeholders through,
# printing "Unable to fetch secrets" on every terminal open. (Semantics from
# the 2026-07-01 draft, which sat at config/ level and was never sourced.)
is_placeholder_infisical_value() {
  case "${1:-}" in
    ""|https://secrets.example|replace-with-project-id|replace-with-machine-token|replace-with-infra-project-id|replace-with-infra-machine-token|replace-with-client-id|replace-with-client-secret)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# A real SECRETS_API_URL rescues a placeholder INFISICAL_API_URL.
if is_placeholder_infisical_value "${INFISICAL_API_URL:-}" && ! is_placeholder_infisical_value "${SECRETS_API_URL:-}"; then
  export INFISICAL_API_URL="$SECRETS_API_URL"
fi
if is_placeholder_infisical_value "${INFISICAL_API_URL:-}"; then unset INFISICAL_API_URL; fi
if is_placeholder_infisical_value "${INFISICAL_PROJECT_ID:-}"; then unset INFISICAL_PROJECT_ID; fi
if is_placeholder_infisical_value "${INFISICAL_TOKEN:-}"; then unset INFISICAL_TOKEN; fi
if is_placeholder_infisical_value "${INFISICAL_CLIENT_ID:-}"; then unset INFISICAL_CLIENT_ID; fi
if is_placeholder_infisical_value "${INFISICAL_CLIENT_SECRET:-}"; then unset INFISICAL_CLIENT_SECRET; fi
unset -f is_placeholder_infisical_value

# Configured means: a machine token, OR universal-auth client credentials
# (iexport exchanges those for a short-lived token itself — nothing expiring
# is ever stored on disk).
INFISICAL_HAS_TOKEN=0
if [ -n "${INFISICAL_TOKEN:-}" ] || { [ -n "${INFISICAL_CLIENT_ID:-}" ] && [ -n "${INFISICAL_CLIENT_SECRET:-}" ]; }; then
  INFISICAL_HAS_TOKEN=1
fi
if [ "$INFISICAL_HAS_TOKEN" -ne 1 ] || [ -z "${INFISICAL_PROJECT_ID:-}" ] || [ -z "${INFISICAL_API_URL:-}" ]; then
  return 0
fi

# ---- Load Secrets from Infisical (with Caching & The Generic 'iexport' Tool) ----
#
# This is the definitive setup for an interactive shell. It uses our
# self-built 'iexport' utility and a local cache for instant startup.

# 1. Define the location for our local secret cache file.
INFISICAL_CACHE_FILE="$HOME/.infisical_secrets"

# 2. Define how long the cache should be valid (in seconds). 3600 = 1 hour.
CACHE_TTL=3600

# 3. Check if the cache file exists and is not too old.
if [ -f "$INFISICAL_CACHE_FILE" ] && [ "$(($(date +%s) - $(stat -c %Y "$INFISICAL_CACHE_FILE")))" -lt "$CACHE_TTL" ]; then
  # --- FAST PATH ---
  # Cache is valid. Load secrets directly from the local file.
  source "$INFISICAL_CACHE_FILE"
else
  # --- SLOW PATH ---
  # Cache is old or missing. Call our powerful 'iexport' tool to regenerate it.
  #echo "Refreshing secrets from Infisical..." >&2 # Message to stderr
  
  # 'iexport' produces the perfect 'export KEY=VALUE' output for our cache file.
  # A failed refresh must NOT become a fresh cache (that masks the outage for a
  # full TTL and surfaces the error only on the next hour's terminal open).
  if ! iexport > "$INFISICAL_CACHE_FILE"; then
    rm -f "$INFISICAL_CACHE_FILE"
    echo "infisical.template: secret refresh failed; continuing without secrets" >&2
    return 0
  fi

  # Load the secrets from the newly created cache file.
  source "$INFISICAL_CACHE_FILE"
fi
