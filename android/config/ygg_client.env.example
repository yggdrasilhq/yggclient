# Optional install and boot overrides for Android Termux yggsync.
# Copy to ~/.config/ygg_client.env if you want persistent overrides.

# Periodic schedules for the generated Termux jobs.
YGG_OBSIDIAN_PERIOD_MS=10800000
# Deprecated compatibility alias:
YGG_FAST_PERIOD_MS=10800000
YGG_BULK_PERIOD_MS=43200000

# Auto-update the checkout during boot job registration.
YGG_AUTO_UPDATE=0

# Override binary/config paths if needed.
YGG_BIN=$HOME/.local/bin/yggsync
YGG_SYNC_CONFIG=$HOME/.config/ygg_sync.toml
YGG_SYNC_RUNTIME=$HOME/.config/yggsync.runtime.toml

# Optional yggsync-core fetch version for android/scripts/fetch-yggsync.sh.
YGGSYNC_VERSION=v0.3.0

# --- android/scripts/setup-sshd-service.sh ---------------------------------
# The workstation public key to authorize on the phone, verbatim.
YGG_SSHD_AUTHORIZED_KEY='ssh-ed25519 AAAA... user@workstation'
# Comma-separated CIDRs that key may connect FROM, e.g. your VPN range plus
# your LAN. Leave empty to authorize it from any address (say so out loud).
YGG_SSHD_ALLOWED_SOURCES='10.0.0.0/8,192.168.0.0/16'
# Listen port, and the persisted watchdog job that keeps sshd up.
YGG_SSHD_PORT=8022
YGG_SSHD_WATCHDOG_JOB_ID=103
# 900000ms (15 min) is the Android JobScheduler minimum period.
YGG_SSHD_WATCHDOG_PERIOD_MS=900000
