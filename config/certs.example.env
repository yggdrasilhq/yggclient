# Copy to config/certs.local.env and fill with real values.
# This file is for certificate acquisition and certificate distribution helpers.

# Certificate identity
CERT_PRIMARY_DOMAIN=example.com
LEGO_DOMAINS="example.com *.example.com"
LEGO_ACCOUNT_EMAIL=ops@example.com
LEGO_KEY_TYPE=rsa2048

# Storage and runtime
LEGO_STORAGE_PATH=/etc/letsencrypt/example.com
LEGO_INSTALL_DIR=/etc/letsencrypt/example.com/lego
LEGO_EXEC_NAME=lego
LEGO_DNS_PROVIDER=porkbun
LEGO_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53

# Provider credentials
PORKBUN_SECRET_API_KEY=replace-with-provider-secret
PORKBUN_API_KEY=replace-with-provider-key

# Optional downstream reload hooks
NGINX_RELOAD_COMMAND="systemctl reload nginx"
POSTFIX_RELOAD_COMMAND=

# Infisical upload / fetch
INFISICAL_ENV=prod
INFISICAL_API_URL=https://secrets.example
INFISICAL_PROJECT_ID=replace-with-project-id
INFISICAL_TOKEN=replace-with-machine-token
INFISICAL_INFRA_PROJECT_ID=replace-with-infra-project-id
INFISICAL_INFRA_TOKEN=replace-with-infra-machine-token
