[Unit]
Description=Renew SSL certificate via Infisical
After=network.target nss-lookup.target

[Service]
Type=oneshot
User=root

Environment=INFISICAL_INFRA_PROJECT_ID=replace-with-infra-project-id
Environment=INFISICAL_INFRA_TOKEN=replace-with-infra-machine-token
Environment=INFISICAL_API_URL=https://secrets.example

# Set the working directory to where the script is located
WorkingDirectory=/opt/stalwart

# Define the command and its arguments
# Note how the final argument with spaces is quoted
ExecStart=${REPO_ROOT}/scripts/get-cert-from-infisical.sh example.com /etc/certs/example.com.key /etc/certs/example.com.fullchain.pem "echo "

[Install]
WantedBy=timers.target
